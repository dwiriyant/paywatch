ADDR=:8081
DATABASE_URL=postgres://paywatch:paywatch@localhost:5434/paywatch?sslmode=disable
ADMIN_TOKEN=change-me

# Poll interval (ms). Hard floor 5000.
POLL_INTERVAL_MS=6000
DRY_RUN=true

# qrisgate (payment source of truth)
QRISGATE_BASE_URL=http://127.0.0.1:8080
QRISGATE_ADMIN_TOKEN=change-me

CACHE_DIR=.cache
SEEN_STATE_PATH=.paywatch_seen.json
GOBIZ_HISTORY_DAYS=1
GOBIZ_HISTORY_SIZE=30

# Live credential verify endpoints (POST /v1/tenants/verify, /v1/tenants/:id/verify)
VERIFY_RATE_LIMIT_PER_MIN=1
